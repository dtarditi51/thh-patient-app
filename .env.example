# Server-side Google key — Places Details only (per-office reviews).
# Enable: Places API. Application restriction: None (server REST calls send no
# Referer header, so an HTTP-referrer lock would block them). No NEXT_PUBLIC_
# prefix; stays out of the client bundle.
GOOGLE_PLACES_API_KEY=

# Client-side Google key — Maps JavaScript API (interactive locations map).
# Ships to the browser. Enable: Maps JavaScript API. Restrict by HTTP referrer:
#   - http://localhost:3000/*
#   - https://*.vercel.app/*
#   - https://app.hearthousenj.com/*  (or my.hearthousenj.com/*)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Maps Embed API key — location detail page iframes. Lands in the iframe src
# attribute (server-rendered HTML), so still public. Kept separate from the
# Maps JS key so each carries the minimal API restriction for its surface.
# Enable: Maps Embed API. Restrict by HTTP referrer (same list as above).
MAPS_EMBED_API_KEY=

# Optional: Map ID for custom map styling configured in the Google Cloud
# Console. Falls back to a default ID if not set.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Rater8 embed (per-provider widget IDs or API token)
RATER8_API_TOKEN=

# Firebase for push notifications
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_SERVER_KEY=

# Admin bearer token for POST /api/push/send (FCM fanout).
# Generate with: `openssl rand -base64 32`. Required to call the send endpoint.
PUSH_ADMIN_TOKEN=

# Luma Health portal URL (passthrough)
NEXT_PUBLIC_PORTAL_URL=https://portal.hearthousenj.com

# Practice info
NEXT_PUBLIC_MAIN_PHONE=856-546-3003
NEXT_PUBLIC_MAIN_FAX=856-547-5337
